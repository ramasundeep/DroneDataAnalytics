# CD Sim local environment. Copy to .env (make setup does this) and edit.
# .env is gitignored. These defaults are for a developer laptop only;
# field boxes get generated credentials from `make deploy-box` (Phase 8).

COMPOSE_PROJECT_NAME=cdsim

# PostgreSQL + TimescaleDB
CDSIM_DB_USER=cdsim
CDSIM_DB_PASSWORD=cdsim-dev-only
CDSIM_DB_NAME=cdsim
CDSIM_DB_PORT=5432

# Redis
CDSIM_REDIS_PORT=6379

# MinIO (S3-compatible object store for recordings and area packages)
CDSIM_MINIO_ROOT_USER=cdsim
CDSIM_MINIO_ROOT_PASSWORD=cdsim-dev-only
CDSIM_MINIO_PORT=9000
CDSIM_MINIO_CONSOLE_PORT=9001

# Platform service host ports
CDSIM_API_PORT=8000
CDSIM_RECORDER_PORT=8001
CDSIM_ASSESSMENT_PORT=8002

# Terrain twin service host ports
CDSIM_TILES_PORT=8101
CDSIM_MESH_PORT=8102
CDSIM_ELEVATION_PORT=8103
CDSIM_WEATHER_PORT=8104

# Instructor console
CDSIM_CONSOLE_PORT=8080

# ArduPilot SITL (profile: sitl)
CDSIM_SITL_MAVLINK_PORT=5760
CDSIM_SITL_GCS_UDP_PORT=14550

# Image builds behind a TLS-inspecting proxy (optional; leave unset normally)
# CDSIM_BUILD_CA=/path/to/proxy-ca.crt
# CDSIM_BUILD_NETWORK=host
