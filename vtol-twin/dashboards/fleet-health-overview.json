    {
      "id": 9,
      "type": "timeseries",
      "title": "Per-sortie peaks: EGT / vibration / servo current",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-flight-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flight-telemetry"
          },
          "query": "from(bucket: \"flight_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"sortie_summary\" and r[\"tail\"] == \"${tail}\" and (r[\"_field\"] == \"egt_max_c\" or r[\"_field\"] == \"vib_rms_max\" or r[\"_field\"] == \"servo3_current_max_a\"))\n  |> yield(name: \"peaks\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 7,
            "lineWidth": 1,
            "showPoints": "always",
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "egt_max_c"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vib_rms_max"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "servo3_current_max_a"
            },
            "properties": [
              {
                "id": "unit",
                "value": "amp"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
