          "query": "from(bucket: \"flight_telemetry\")\n  |> range(start: -1y)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"life_counters\" and r[\"tail\"] == \"${tail}\" and r[\"_field\"] == \"hours_used_pct\")\n  |> group(columns: [\"component\"])\n  |> last()\n  |> keep(columns: [\"component\", \"_value\"])"
        }
