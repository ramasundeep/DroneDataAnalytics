    {
      "id": 7,
      "type": "bargauge",
      "title": "Component health score (analytics, Phase 3)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-flight-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flight-telemetry"
          },
          "query": "from(bucket: \"flight_telemetry\")\n  |> range(start: -1y)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"health\" and r[\"tail\"] == \"${tail}\" and r[\"_field\"] == \"healthScore\")\n  |> group(columns: [\"component\"])\n  |> last()\n  |> keep(columns: [\"component\", \"_value\"])"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 16,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "yellow",
                "value": 65
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      }
    },
