      "id": 1,
      "type": "stat",
      "title": "Sorties in range",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-flight-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flight-telemetry"
          },
          "query": "from(bucket: \"flight_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"sortie_summary\" and r[\"tail\"] == \"${tail}\" and r[\"_field\"] == \"flight_hours\")\n  |> count()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
