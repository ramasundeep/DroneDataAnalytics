    },
    {
      "id": 10,
      "type": "table",
      "title": "Sortie log",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-flight-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flight-telemetry"
          },
          "query": "from(bucket: \"flight_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"sortie_summary\" and r[\"tail\"] == \"${tail}\")\n  |> pivot(rowKey: [\"_time\", \"sortie\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"sortie\", \"flight_hours\", \"landings\", \"egt_max_c\", \"egt_mean_c\", \"vib_rms_max\", \"vib_rms_mean\", \"servo3_current_max_a\", \"degradation\"])\n  |> sort(columns: [\"_time\"], desc: true)"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
