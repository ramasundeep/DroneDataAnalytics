# MQTT -> InfluxDB ingester (bridge/mqtt_ingest.py) and .ulg batch ingester (bridge/ulog_ingest.py).
# When run from the host with `make`, the values in vtol-twin/.env are used instead.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPICS=vtol/+/telemetry,vtol/+/telemetry/+
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=vtol-twin-dev-token-change-me
INFLUXDB_ORG=vtol
INFLUXDB_BUCKET=flight_telemetry
SOURCE_TAG=live
INGEST_PORT=8091
DITTO_URL=http://ditto-nginx
DITTO_USER=ditto
DITTO_PASSWORD=ditto
THING_ID=vtol.fleet:VTOL-1
TAIL_NUMBER=VTOL-1
LOG_LEVEL=INFO
