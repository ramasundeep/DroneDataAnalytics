# Copy to .env and adjust. Nothing in this file is a real secret for a bench prototype,
# but .env itself is git-ignored so per-host values never get committed.
COMPOSE_PROJECT_NAME=vtol-twin
TZ=UTC

# ---- image pins (see VERSIONS.md) ----
DITTO_VERSION=3.9.7
MONGO_VERSION=7.0.40
NGINX_VERSION=1.27-alpine
MOSQUITTO_VERSION=2.0.22
INFLUXDB_VERSION=2.7.12-alpine
GRAFANA_VERSION=12.4.3

# ---- aircraft ----
TAIL_NUMBER=VTOL-1
DITTO_NAMESPACE=vtol.fleet
THING_ID=vtol.fleet:VTOL-1
POLICY_ID=vtol.fleet:vtol-policy

# ---- Ditto (twin state) ----
DITTO_EXTERNAL_PORT=8080
# operator login for the REST API / UI (basic auth terminated by nginx)
DITTO_USER=ditto
DITTO_PASSWORD=ditto
# devops password guards /api/2/connections and /devops
DITTO_DEVOPS_PASSWORD=devops-change-me

# ---- Mosquitto (connectivity) ----
MQTT_HOST=localhost
MQTT_PORT=1883

# ---- InfluxDB 2.x (time-series) ----
INFLUXDB_PORT=8086
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=influx-change-me
INFLUXDB_ORG=vtol
INFLUXDB_BUCKET=flight_telemetry
# 0 = keep forever
INFLUXDB_RETENTION=0
INFLUXDB_TOKEN=vtol-twin-dev-token-change-me

# ---- Grafana ----
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-change-me

# ---- demo mode (make demo-ui-live) ----
DEMO_PORT=8090
DEMO_SPEED=20

# ---- telemetry pipeline (Phase 2) ----
INGEST_PORT=8091
