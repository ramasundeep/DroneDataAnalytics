# Analytics service (anomaly detection + RUL). With `make`, vtol-twin/.env values are used instead.
ANALYTICS_PORT=8092
ANALYTICS_SOURCE=influx          # influx | ulog (offline, scores ULOG_GLOB)
ULOG_GLOB=/app/data/samples/*.ulg
ANALYTICS_INTERVAL_S=900
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=vtol-twin-dev-token-change-me
INFLUXDB_ORG=vtol
INFLUXDB_BUCKET=flight_telemetry
DITTO_URL=http://ditto-nginx
DITTO_USER=analytics
DITTO_PASSWORD=analytics-change-me
THING_ID=vtol.fleet:VTOL-1
TAIL_NUMBER=VTOL-1
MQTT_HOST=mosquitto              # optional: re-run when a sortie is ingested (lifeCounters event)
MQTT_PORT=1883
LOG_LEVEL=INFO
